{
  "version": 2,
  "functions": {
    "api/relatorio.js": { "maxDuration": 30 },
    "api/slack-comando.js": { "maxDuration": 30 },
    "api/relatorio-imobiliario.js": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/relatorio-imobiliario?cron=sla_alertas", "schedule": "0 12 * * 1-5" }
  ],
  "rewrites": [
    { "source": "/sobre", "destination": "/sobre.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}